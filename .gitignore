# crap4dart profiling
profile-reports/
.crap_profile_temp/
fa-local/
# Runtime agent working directory (bash job logs, transient state).
# .fah holds local-only junk (logs, sessions, bash_jobs, scratch) — but a
# curated subset is committed on purpose: the project config, stream
# rules, lsp/mcp settings, agents and skills.
.fah/*
!.fah/config.yaml
!.fah/rules.yaml
!.fah/lsp.json
!.fah/mcp.json
!.fah/agents/
!.fah/skills/
!.fah/packages.yaml

# Embedded browser-extension agent: dart2js output (built by
# scripts/build_browser_ext.sh), plus the local package's tooling dirs.
browser_ext/sw/agent.js
browser_ext/sw/agent.js.map
browser_ext/sw/agent.js.deps
browser_ext/app/
browser_ext/dart/build/
