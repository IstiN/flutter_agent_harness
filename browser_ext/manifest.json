{
  "manifest_version": 3,
  "name": "fa — browser agent",
  "version": "0.3.0",
  "key": "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEKyWbUCtoIY5CLA1J8Msmfo+b+3FsPttbTWDA1Pe/XvnNv1D2u7uXXeJwIF3QH8AyhmE26ZRj8JcxFDlf1X0ibw==",
  "description": "fa — your agent in this browser: the full fa app in the side panel, page powers for the agent.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": "icons/icon-32.png"
  },
  // Issue #137 — maximum viable permission set: the generic chrome.*
  // bridge (browser_api) exposes every declared namespace to the agent,
  // so permissions without access are pure waste. Tier 3 exclusions
  // (documented here + permission_matrix.dart):
  //   enterprise.*            — device-admin, managed contexts only
  //   platformKeys            — ChromeOS-only
  //   fileSystemProvider      — ChromeOS-only
  //   wallpaper               — ChromeOS-only
  //   gcm / instanceID        — legacy push transport, no agent surface
  //   devtools                — opens interactive windows, not automation
  //   passwords               — chrome exposes no such API at all
  // `commands`/`omnibox` are manifest KEYS (below), not permissions.
  // `management` is declared but bridge-default-DENIED (self-preservation:
  // an injected page must not disable the agent's own extension).
  "permissions": [
    "alarms",
    "bookmarks",
    "browsingData",
    "clipboardRead",
    "clipboardWrite",
    "contentSettings",
    "contextMenus",
    "cookies",
    "debugger",
    "declarativeNetRequest",
    "downloads",
    "fontSettings",
    "history",
    "identity",
    "idle",
    "management",
    "nativeMessaging",
    "notifications",
    "offscreen",
    "power",
    "privacy",
    "proxy",
    "readingList",
    "scripting",
    "search",
    "sessions",
    "sidePanel",
    "storage",
    "system.cpu",
    "system.display",
    "system.memory",
    "system.storage",
    "tabCapture",
    "tabGroups",
    "tabs",
    "tts",
    "unlimitedStorage",
    "webNavigation",
    "webRequest"
  ],
  "optional_permissions": [
    "desktopCapture",
    "pageCapture",
    "topSites",
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "ask-fa": {
      "suggested_key": {
        "default": "Ctrl+Shift+1"
      },
      "description": "Ask fa about the current page"
    }
  },
  "omnibox": {
    "keyword": "fa"
  },
  "background": {
    "service_worker": "sw/main.js"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
