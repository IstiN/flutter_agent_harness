#!/usr/bin/env bash
# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  QUALITY GATE — DO NOT LOWER THESE THRESHOLDS WITHOUT TEAM APPROVAL       ║
# ║  Every commit must pass: file size, analyze, tests, coverage ≥ 80%,       ║
# ║  CRAP ratchet (crap4dart.yaml), duplication < 1%.                         ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
#
# Pre-commit hook for flutter_agent_harness (pure Dart package).
# Canonical copy: scripts/pre-commit — install with:
#   cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# To skip (emergency only): git commit --no-verify

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Unset git env vars so test processes that spawn git subprocesses use the
# correct working directory rather than the hook's environment.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE 2>/dev/null || true

COVERAGE_BASELINE=80.0
DUP_THRESHOLD=1.0
# flutter_app duplication ratchet: pre-existing clones (memory/wasm shells,
# on-device cache sections + stream functions, settings connect flows) sit
# at ~3.66% — only allowed DOWN from here. Real debt items to dedupe:
# memory_shell/wasm_shell, transformers_js/webllm/gemma cache sections,
# wasm_shell_git/web_git.
DUP_THRESHOLD_APP=3.7
MAX_LINES=2800

# ═══════════════════════════════════════════════════════════════════════════
# 1. FILE SIZE GUARD
# ═══════════════════════════════════════════════════════════════════════════
VIOLATIONS=()
while IFS= read -r file; do
  case "$file" in
    *.dart)
      case "$file" in
        *.g.dart|*.freezed.dart|*.mocks.dart|*bridge_generated*.dart) continue ;;
      esac
      lines=$(wc -l < "$file")
      if (( lines > MAX_LINES )); then
        VIOLATIONS+=("  $file: $lines lines (max $MAX_LINES)")
      fi
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM)

if ((${#VIOLATIONS[@]} > 0)); then
  echo ""
  echo "╔═══════════════════════════════════════════════════════════════════════════╗"
  echo "║  ❌ QUALITY GATE FAILED — FILE SIZE                                       ║"
  echo "╚═══════════════════════════════════════════════════════════════════════════╝"
  printf '%s\n' "${VIOLATIONS[@]}"
  exit 1
fi

# ═══════════════════════════════════════════════════════════════════════════
# 2. STATIC ANALYSIS
# ═══════════════════════════════════════════════════════════════════════════
echo "🔍 Running dart analyze..."
dart analyze

echo "🔍 Checking dart format..."
# Explicit package dirs: the repo also hosts standalone workspaces with their
# own toolchains (yoclip/ video production) that must not gate harness commits.
dart format --output=none --set-exit-if-changed lib test bin example scripts flutter_app packages

# ═══════════════════════════════════════════════════════════════════════════
# 3. TESTS WITH COVERAGE
# ═══════════════════════════════════════════════════════════════════════════
# Integration tests call external LLM endpoints and are too slow/non-deterministic
# for a pre-commit gate; they run in CI / manually instead.
echo "🧪 Running dart test --coverage (excluding integration tests)..."
rm -rf coverage
dart test --coverage=coverage --exclude-tags integration

echo "📊 Formatting coverage to lcov..."
dart run coverage:format_coverage --lcov -i coverage -o coverage/lcov.info

# ═══════════════════════════════════════════════════════════════════════════
# 4. COVERAGE RATCHET (lib/ only)
# ═══════════════════════════════════════════════════════════════════════════
echo "🔍 Checking line coverage (baseline: >= ${COVERAGE_BASELINE}%)..."
if python3 scripts/check_coverage.py "$COVERAGE_BASELINE"; then
  echo "✅ Coverage gate OK"
else
  echo ""
  echo "╔═══════════════════════════════════════════════════════════════════════════╗"
  echo "║  ❌ QUALITY GATE FAILED — TEST COVERAGE                                   ║"
  echo "╚═══════════════════════════════════════════════════════════════════════════╝"
  echo "   Add tests for uncovered code, then retry."
  exit 1
fi

# ═══════════════════════════════════════════════════════════════════════════
# 5. CRAP RATCHET (complexity × coverage; threshold pinned in crap4dart.yaml)
# ═══════════════════════════════════════════════════════════════════════════
if command -v dart >/dev/null 2>&1 && \
   dart pub global run crap4dart --version >/dev/null 2>&1; then
  echo "🔍 Checking CRAP scores (ratchet: only down from the pinned max)..."
  # Reuses the fresh coverage/lcov.info produced above.
  if dart pub global run crap4dart analyze; then
    echo "✅ CRAP gate OK"
  else
    echo ""
    echo "╔═══════════════════════════════════════════════════════════════════════════╗"
    echo "║  ❌ QUALITY GATE FAILED — CRAP RATCHET                                    ║"
    echo "╚═══════════════════════════════════════════════════════════════════════════╝"
    echo "   A method's CRAP score exceeded the pinned max in crap4dart.yaml."
    echo "   Simplify it or add tests — the threshold only goes DOWN."
    exit 1
  fi
else
  echo "⚠️  crap4dart not activated (dart pub global activate crap4dart 0.1.1) — skipping CRAP gate"
fi

# ═══════════════════════════════════════════════════════════════════════════
# 6. CODE DUPLICATION GUARD
# ═══════════════════════════════════════════════════════════════════════════
if command -v jscpd >/dev/null 2>&1; then
  echo "🔍 Checking code duplication (thresholds: core < ${DUP_THRESHOLD}%, flutter_app < ${DUP_THRESHOLD_APP}%)..."
  dup_pct() {
    jscpd --min-tokens 50 --min-lines 5 --reporters json --output "$2" "$1" >/dev/null 2>&1 || true
    python3 -c "
import json
try:
    with open('$2/jscpd-report.json') as f:
        d=json.load(f)
    print(d['statistics']['total']['percentage'])
except Exception:
    print('0.0')
" 2>/dev/null || echo "0.0"
  }
  CORE_DUP=$(dup_pct lib/ /tmp/jscpd-precommit-core)
  APP_DUP=$(dup_pct flutter_app/lib/ /tmp/jscpd-precommit-app)
  DUP_OK=1
  if python3 -c "exit(0 if float('$CORE_DUP') < float('$DUP_THRESHOLD') else 1)"; then
    echo "✅ Core duplication check OK ($CORE_DUP% < ${DUP_THRESHOLD}%)"
  else
    DUP_OK=0
  fi
  if python3 -c "exit(0 if float('$APP_DUP') < float('$DUP_THRESHOLD_APP') else 1)"; then
    echo "✅ flutter_app duplication check OK ($APP_DUP% < ${DUP_THRESHOLD_APP}%)"
  else
    DUP_OK=0
  fi
  if (( DUP_OK == 0 )); then
    echo ""
    echo "╔═══════════════════════════════════════════════════════════════════════════╗"
    echo "║  ❌ QUALITY GATE FAILED — CODE DUPLICATION                                ║"
    echo "╚═══════════════════════════════════════════════════════════════════════════╝"
    echo "   Core: $CORE_DUP% (max ${DUP_THRESHOLD}%) · flutter_app: $APP_DUP% (max ${DUP_THRESHOLD_APP}%)"
    echo "   Run: jscpd --min-tokens 50 --min-lines 5 lib/ flutter_app/lib/"
    exit 1
  fi
else
  echo "⚠️  jscpd not found, skipping duplication check (npm install -g jscpd)"
fi

# ═══════════════════════════════════════════════════════════════════════════
# 6. EXAMPLE APP: flutter test (incl. golden suite) + golden gate
# ═══════════════════════════════════════════════════════════════════════════
if command -v flutter >/dev/null 2>&1; then
  echo "🔍 Running flutter analyze (flutter_app)..."
  if ! (cd flutter_app && flutter analyze --no-fatal-infos --no-fatal-warnings); then
    echo ""
    echo "╔═══════════════════════════════════════════════════════════════════════════╗"
    echo "║  ❌ QUALITY GATE FAILED — FLUTTER ANALYZE                                 ║"
    echo "╚═══════════════════════════════════════════════════════════════════════════╝"
    exit 1
  fi
  echo "🧪 Running flutter_app tests (incl. golden tests)..."
  if ! (cd flutter_app && flutter test); then
    echo ""
    echo "╔═══════════════════════════════════════════════════════════════════════════╗"
    echo "║  ❌ QUALITY GATE FAILED — FLUTTER APP TESTS                               ║"
    echo "╚═══════════════════════════════════════════════════════════════════════════╝"
    echo "   Fix the failing flutter_app tests, then retry."
    echo "   UI change? Regenerate goldens:"
    echo "   cd flutter_app && flutter test test/golden --update-goldens"
    echo "   — and review every changed PNG before committing."
    exit 1
  fi
  echo "🔍 Checking golden coverage..."
  if python3 scripts/check_goldens.py --quick; then
    echo "✅ Golden gate OK"
  else
    exit 1
  fi
else
  echo "⚠️  flutter not found, skipping flutter_app tests + golden gate"
fi

echo ""
echo "╔═══════════════════════════════════════════════════════════════════════════╗"
echo "║  ✅ ALL QUALITY GATES PASSED — COMMIT APPROVED                            ║"
echo "╚═══════════════════════════════════════════════════════════════════════════╝"
