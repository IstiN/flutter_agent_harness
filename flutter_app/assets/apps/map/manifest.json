{
  "id": "map",
  "name": "Map",
  "description": "OpenStreetMap with preset landmarks — tap to drop your own pins",
  "version": "1.0.0",
  "icon": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 2 C7.6 2 4 5.6 4 10 C4 15.4 12 22 12 22 C12 22 20 15.4 20 10 C20 5.6 16.4 2 12 2 Z' fill='#ef4444'/><circle cx='12' cy='10' r='3' fill='#fecaca'/></svg>",
  "allowedCommands": [],
  "network": true,
  "cli": {
    "summary": "OSM map of Grodno with tappable markers and zoom controls",
    "events": [
      { "id": "zoom_in", "description": "Increase zoom level" },
      { "id": "zoom_out", "description": "Decrease zoom level" },
      { "id": "map_tap", "description": "Drop a pin (payload: {lat, lng})" },
      { "id": "marker_tap", "description": "Show marker details (payload: {id})" },
      { "id": "select_<id>", "description": "Center on a marker and show details" },
      { "id": "remove_<id>", "description": "Remove a user pin" }
    ],
    "read": {
      "state": "yoloit app:state map — zoom, markerCount, selected",
      "snapshot": "yoloit app:snapshot map — full render JSON tree"
    },
    "examples": [
      "yoloit app:run map",
      "yoloit app:execute map zoom_in",
      "yoloit app:execute map map_tap '{\"lat\":53.68,\"lng\":23.84}'",
      "yoloit app:state map"
    ]
  }
}
