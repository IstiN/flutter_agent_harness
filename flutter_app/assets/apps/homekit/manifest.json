{
  "id": "homekit",
  "name": "Home",
  "description": "HomeKit bridge status plus a demo smart-home control panel",
  "version": "1.0.0",
  "icon": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 3 L22 11 L19.5 11 L19.5 21 L14 21 L14 15 L10 15 L10 21 L4.5 21 L4.5 11 L2 11 Z' fill='#f59e0b'/></svg>",
  "allowedCommands": [],
  "network": false,
  "homekit": true,
  "cli": {
    "summary": "HomeKit bridge status + demo device panel with local state",
    "events": [
      { "id": "retry", "description": "Retry the homekit bridge call" },
      { "id": "toggle_<id>", "description": "Toggle a light or the lock" },
      { "id": "temp_up", "description": "Raise the demo thermostat" },
      { "id": "temp_down", "description": "Lower the demo thermostat" }
    ],
    "read": {
      "state": "yoloit app:state homekit — bridgeAvailable, devices",
      "snapshot": "yoloit app:snapshot homekit — full render JSON tree"
    },
    "examples": [
      "yoloit app:run homekit",
      "yoloit app:execute homekit toggle_living-light",
      "yoloit app:state homekit"
    ]
  }
}
