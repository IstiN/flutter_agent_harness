{
  "id": "contacts",
  "name": "Contacts",
  "description": "Search your system contacts, call or text them, add new ones",
  "version": "1.0.0",
  "platforms": ["ios", "macos"],
  "icon": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><rect x='4' y='2.5' width='16' height='19' rx='3' fill='#0ea5e9'/><rect x='4' y='2.5' width='4' height='19' rx='2' fill='#0369a1'/><rect x='5.5' y='6' width='1.5' height='2.4' rx='0.75' fill='#7dd3fc'/><rect x='5.5' y='10.8' width='1.5' height='2.4' rx='0.75' fill='#7dd3fc'/><rect x='5.5' y='15.6' width='1.5' height='2.4' rx='0.75' fill='#7dd3fc'/><circle cx='13.5' cy='9.5' r='2.6' fill='#e0f2fe'/><path d='M8.7 17.2c0-2.6 2.1-4.2 4.8-4.2s4.8 1.6 4.8 4.2c0 .5-.4.8-.8.8H9.5c-.4 0-.8-.3-.8-.8z' fill='#e0f2fe'/></svg>",
  "allowedCommands": [],
  "network": false,
  "contacts": true,
  "cli": {
    "summary": "System contacts search with call/SMS actions and an add form",
    "events": [
      { "id": "search_submit", "description": "Run the search for the current query" },
      { "id": "contact_0", "description": "Open the first result's detail card" },
      { "id": "add_open", "description": "Open the add-contact form" },
      { "id": "retry", "description": "Reload after granting permission" }
    ],
    "read": {
      "state": "yoloit app:state contacts — query, resultCount, selected, error",
      "snapshot": "yoloit app:snapshot contacts — full render JSON tree"
    },
    "examples": [
      "yoloit app:run contacts",
      "yoloit app:execute contacts search_submit",
      "yoloit app:state contacts"
    ]
  }
}
