{
  "id": "health",
  "name": "Health",
  "description": "HealthKit dashboard (steps, heart rate, sleep) with a demo fallback when the bridge is unavailable",
  "version": "1.1.0",
  "icon": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M12 21 C6 16.5 2.5 12.8 2.5 8.9 C2.5 5.9 4.9 3.5 7.9 3.5 C9.7 3.5 11.2 4.4 12 5.7 C12.8 4.4 14.3 3.5 16.1 3.5 C19.1 3.5 21.5 5.9 21.5 8.9 C21.5 12.8 18 16.5 12 21 Z' fill='#f43f5e'/><polyline points='4.5,11.5 8.5,11.5 10.5,7.5 13.5,15 15.5,11.5 19.5,11.5' fill='none' stroke='#fff1f2' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'/></svg>",
  "allowedCommands": [],
  "network": false,
  "health": true,
  "cli": {
    "summary": "HealthKit dashboard (steps/HR/sleep) + demo fallback",
    "events": [
      { "id": "retry", "description": "Retry the health bridge call" }
    ],
    "read": {
      "state": "yoloit app:state health — bridgeAvailable, bridgeError",
      "snapshot": "yoloit app:snapshot health — full render JSON tree"
    },
    "examples": [
      "yoloit app:run health",
      "yoloit app:execute health retry",
      "yoloit app:state health"
    ]
  }
}
